# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing in src/ reads these directly except src/statesync/llm/client.py and
# src/statesync/config.py. Keep it that way: one place to audit, one place to
# rotate.

# ── LLM providers ───────────────────────────────────────────────────────────
# Resolution order is primary -> secondary -> deterministic (DEGRADED_MODE).
# Any of these may be absent; with none set the offline heuristic client runs
# and the cache manifest records that the figures are not provider costs.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── infrastructure (defaults work with docker-compose; override if needed) ──
# STATESYNC_ADMIN_DSN=postgresql://statesync:statesync@localhost:55432/statesync
# STATESYNC_APP_DSN=postgresql://statesync_app:statesync_app@localhost:55432/statesync
# STATESYNC_REDIS_URL=redis://localhost:56379/0

# STATESYNC_STRICT=1     # dev: raise on a violated invariant. 0: fail closed.
